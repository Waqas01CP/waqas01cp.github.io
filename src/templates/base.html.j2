{# The document shell. The page is complete without scripts: every word is
   here, every section reads in order, and every disclosure that needs a
   script starts open. static/site.js only reveals, filters and animates
   (scope floor line 7). Every internal path is root-relative (ADR-0002),
   and nothing is loaded from another site (scope floor line 9). #}
<!doctype html>
<!-- Generated by build.py from src/. Edit the source, not this file. -->
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# The month `present` resolved to. The rebuild gate reads it back and
   rebuilds with it rather than with the clock (ADR-0006 Changes). #}
<meta name="as-of" content="{{ as_of }}">
<title>{{ site.name }}</title>
<meta name="description" content="{{ site.headline|join(' | ') }}">
<meta name="color-scheme" content="light dark">
{# An empty icon, so the browser does not ask the server for one. #}
<link rel="icon" href="data:,">
{# All three faces set text on the opening screen. Preloaded, they arrive
   with the stylesheet rather than after first paint, so the text does not
   reflow when they swap in (ADR-0009, layout shift). #}
<link rel="preload" href="/static/fonts/manrope-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/jetbrains-mono-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/site.css">
<script src="/static/site.js" defer></script>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
{% include "nav.html.j2" %}
<main id="main">
{% include "intro.html.j2" %}
<div class="page">
{% include "projects.html.j2" %}
{% include "timeline.html.j2" %}
{% include "work.html.j2" %}
{% include "education.html.j2" %}
{% include "certifications.html.j2" %}
{% include "skills.html.j2" %}
{% include "contact.html.j2" %}
</div>
</main>
{% include "footer.html.j2" %}
</body>
</html>
