{# The document shell and the page. Unstyled on purpose: the design work is
   given this markup to design against (Brief 1). Every internal path is
   root-relative (ADR-0002). #}
{% set site_name = "Waqas Sharif" %}
{# Dates as parts from build.date_phrase, each date in its own <time>. Used
   by item.html.j2 and timeline.html.j2, which see it through include. #}
{% macro when(w) -%}
<time datetime="{{ w.start }}">{{ w.start_text }}</time>
{%- if w.end_text %} to {% if w.end %}<time datetime="{{ w.end }}">{{ w.end_text }}</time>{% else %}{{ w.end_text }}{% endif %}{% endif %}
{%- endmacro %}
<!doctype html>
<!-- Generated by build.py from src/. Edit the source, not this file. -->
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site_name }}</title>
<link rel="stylesheet" href="/static/timeline.css">
</head>
<body>
<a href="#main">Skip to main content</a>
<header>
<h1>{{ site_name }}</h1>
</header>
<main id="main">
{% for section in sections %}
<section id="{{ section.id }}">
<h2>{{ section.heading }}</h2>
{% for item in section.members %}
{% include "item.html.j2" %}
{% endfor %}
</section>
{% endfor %}
{% include "timeline.html.j2" %}
</main>
</body>
</html>
