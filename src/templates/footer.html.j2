{# The footer. The CV link renders only when the PDF exists in the tree being
   built (ADR-0008), exactly as in the Intro. #}
<footer class="foot">
<p class="foot-name serif">{{ site.name }}</p>
<p class="foot-loc">{{ site.location }}</p>
{% if cv %}
<p><a class="foot-link" href="{{ cv }}" download>Download CV (PDF)</a></p>
{% endif %}
<p><a class="foot-link" href="#intro">Back to top <span aria-hidden="true">&uarr;</span></a></p>
{% if site.footer %}
{# The master's Portfolio Footer, word for word, its repository address a
   link (ADR-0008 Changes, 2026-10-15). Text and link are inline in one
   paragraph, so a screen reader reads one run and needs no hidden space. #}
<p class="foot-note">{{ site.footer.before }}<a href="{{ site.footer.link.url }}">{{ site.footer.link.text }}</a>{{ site.footer.after }}</p>
{% endif %}
</footer>
