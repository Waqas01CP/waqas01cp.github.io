{# Work, newest first as the content file lists it. The master holds nothing
   beyond each entry's bullets, so they are shown in full with no disclosure.
   Neither entry carries a proof link or a verification line (ADR-0010). #}
{% import "macros.html.j2" as m %}
<section id="work" class="sec" aria-labelledby="h-work" data-section>
<div class="wrap">
{{ m.head(sections[3]) }}
<div class="jobs">
{% for w in work %}
<article id="{{ w.id }}" class="job" aria-labelledby="h-{{ w.id }}" data-tilt>
<span class="glare" aria-hidden="true"></span>
<div class="job-head">
<p class="job-top"><span class="tile{% if loop.first %} tile-acc{% endif %}" aria-hidden="true">{{ m.icon("case", 22) }}</span><span class="job-dates">{{ m.when(w.when) }}</span></p>
<h3 id="h-{{ w.id }}">{{ w.title }}</h3>
<p class="job-org">{{ w.org }}</p>
<p class="job-loc">{{ w.location }}</p>
</div>
<ul class="job-list">
{% for b in w.bullets %}
<li>{{ b|safe }}</li>
{% endfor %}
</ul>
</article>
{% endfor %}
</div>
</div>
</section>
